--- a/platform/web/SCsub
+++ b/platform/web/SCsub
@@ -87,6 +87,11 @@ if env["dlink_enabled"]:
     sys_env.Append(CCFLAGS=["-s", "MAIN_MODULE=1"])
     sys_env.Append(LINKFLAGS=["-s", "MAIN_MODULE=1"])
     sys_env.Append(LINKFLAGS=["-s", "EXPORT_ALL=1"])
+    # Native WebAssembly exception handling, so the main runtime defines and exports the
+    # __cpp_exception tag. A GDExtension that throws cannot be instantiated without it, and
+    # the tag has to come from the main module because side modules import it.
+    sys_env.Append(CCFLAGS=["-fwasm-exceptions"])
+    sys_env.Append(LINKFLAGS=["-fwasm-exceptions"])
     sys_env.Append(LINKFLAGS=["-s", "WARN_ON_UNDEFINED_SYMBOLS=0"])
     sys_env["CCFLAGS"].remove("-fvisibility=hidden")
     sys_env["LINKFLAGS"].remove("-fvisibility=hidden")
